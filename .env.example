# Django
# Generate a unique value for production; never commit the real .env file.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# MySQL
DB_NAME=thai_food_manager
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Set True only when HTTPS is terminated by Nginx/IIS/a load balancer.
SECURE_SSL_REDIRECT=False
