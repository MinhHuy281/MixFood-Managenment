# Django
# Generate a unique value for production; never commit the real .env file.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,.vercel.app
CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# Chế độ 1: MySQL Local (Đồng bộ lên Cloud bằng: python manage.py sync_cloud_db)
DB_NAME=mixfood_manager
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SSL=False

# Chế độ 2: Dùng chung 1 CSDL Cloud Aiven giữa Local & Vercel (Single Source of Truth)
# DB_NAME=defaultdb
# DB_USER=avnadmin
# DB_PASSWORD=replace-with-aiven-password
# DB_HOST=mysql-xxxx.aivencloud.com
# DB_PORT=17429
# DB_SSL=True

# Set True only when HTTPS is terminated by Nginx/IIS/a load balancer.
SECURE_SSL_REDIRECT=False
